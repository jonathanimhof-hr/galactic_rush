{
  "name": "galactic-rush-v2",
  "version": "2.0.0",
  "description": "GALACTIC RUSH - an original 3D arcade space racing game (WebGL2, zero dependencies)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.mjs",
    "build": "node build.mjs",
    "server": "node server/index.mjs",
    "test": "node --test tests/*.test.js",
    "test:mp": "node --test --test-concurrency=1 tests/mp/*.test.mjs",
    "playtest": "python3 tests/playtest.py smoke"
  },
  "engines": { "node": ">=18" }
}
