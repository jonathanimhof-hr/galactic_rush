rules_version = '2';
// Galactic Rush V12 — Cloud Firestore security rules. Browsers never read or write the database: every account's
// data goes through the game's account server (server/account/), which signs in with its own service account (not
// subject to these rules) and checks every request (Firebase ID token, verified email, the game's own career rules).
// So no client may touch anything here. Deploy with: firebase deploy --only firestore:rules (or paste into the
// Firebase console under Firestore Database -> Rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
